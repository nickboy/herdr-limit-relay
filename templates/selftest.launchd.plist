<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Weekly selftest watch (Monday 09:30). Replace __REPO__ and __HOME__
     (see README) and load with:
       launchctl bootstrap "gui/$(id -u)" <this file>
     RunAtLoad is INTENTIONAL alongside the weekly schedule: selftest
     costs no tokens, so every login gets a free drift check right when
     an OS/herdr/claude upgrade is most likely to have just happened -
     and it only notifies on failure.                                  -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.herdr-limit.selftest</string>
  <key>ProgramArguments</key>
  <array><string>__REPO__/bin/selftest-watch.sh</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:__HOME__/.local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.herdr-limit/selftest-launchd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.herdr-limit/selftest-launchd.log</string>
</dict>
</plist>
